<Window x:Class="Glassboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Glassboard"
        Width="460"
        Height="650"
        MinWidth="380"
        MinHeight="540"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        SizeChanged="Window_SizeChanged">
    <Border CornerRadius="22"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Glassboard"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="작업 중에 잠깐 꺼내 쓰는 가벼운 보조판"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="닫기"
                        Padding="14,8"
                        Margin="12,0,0,0"
                        Background="#33FFFFFF"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="#40FFFFFF"
                        Click="CloseButton_Click"
                        IsTabStop="False" />
            </Grid>

            <Border Grid.Row="1"
                    Padding="12"
                    Margin="0,0,0,12"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#FF34D399" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Text="대기 중" />
                </StackPanel>
            </Border>

            <Border Grid.Row="2"
                    Padding="14"
                    Margin="0,0,0,12"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="{StaticResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="18">
                <StackPanel>
                    <TextBlock Text="짧은 메모"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <TextBox x:Name="MemoInput"
                             Margin="0,10,0,8"
                             MinHeight="44"
                             TextWrapping="Wrap"
                             AcceptsReturn="False"
                             VerticalScrollBarVisibility="Disabled"
                             Background="{StaticResource InputBrush}"
                             Foreground="{StaticResource TextBrush}"
                             BorderBrush="#44FFFFFF"
                             BorderThickness="1"
                             Padding="10"
                             FontSize="13" />
                    <StackPanel Orientation="Horizontal">
                        <Button Content="메모 저장"
                                Padding="14,8"
                                Background="#2A8AD7FF"
                                Foreground="{StaticResource TextBrush}"
                                BorderBrush="#55FFFFFF"
                                Click="SaveMemo_Click"
                                IsTabStop="False" />
                        <TextBlock Text="한 줄만, 빨리 적기"
                                   Margin="10,0,0,0"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11" />
                    </StackPanel>
                    <TextBlock Text="{Binding LastMemoText}"
                               Margin="0,12,0,0"
                               Foreground="{StaticResource MutedBrush}"
                               FontSize="11"
                               TextTrimming="CharacterEllipsis"
                               TextWrapping="NoWrap" />
                </StackPanel>
            </Border>

            <Border Grid.Row="3"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="최근 클립"
                               Margin="2,0,0,8"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <ListBox x:Name="HistoryList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             MouseLeftButtonUp="HistoryList_MouseLeftButtonUp"
                             KeyDown="HistoryList_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="True" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="18"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="76"
                                                Height="76"
                                                CornerRadius="14"
                                                Background="#1AFFFFFF"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <Grid>
                                                <Image Source="{Binding Image}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="TXT"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding KindLabel}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="  ·  Ctrl+클릭으로 고정"
                                                           Foreground="#FF9CA3AF"
                                                           FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Preview}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TimestampText}"
                                                       Margin="0,8,0,0"
                                                       Foreground="#FF9CA3AF"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="4"
                       Margin="2,12,2,0"
                       Foreground="#FF9CA3AF"
                       FontSize="11"
                       Text="팁: 일반 클릭은 미리보기 선택, Ctrl+클릭은 선택한 항목을 클립보드로 다시 복사합니다." />
        </Grid>
    </Border>
</Window>
