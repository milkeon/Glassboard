<Window x:Class="Glassboard.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="Glassboard"
        Width="520"
        Height="760"
        MinWidth="420"
        MinHeight="600"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        ResizeMode="CanResize"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="True"
        Loaded="Window_Loaded"
        Closed="Window_Closed"
        SizeChanged="Window_SizeChanged">
    <Border CornerRadius="22"
            Background="{StaticResource PanelBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1"
            SnapsToDevicePixels="True">
        <Grid Margin="16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="0,0,0,12" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Glassboard"
                               FontSize="24"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" />
                    <TextBlock Text="작업 중에만 조용히 떠 있는 클립보드·메모·타이머 오버레이"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button Grid.Column="1"
                        Content="닫기"
                        Padding="14,8"
                        Margin="12,0,0,0"
                        Background="#33FFFFFF"
                        Foreground="{StaticResource TextBrush}"
                        BorderBrush="#40FFFFFF"
                        Click="CloseButton_Click"
                        IsTabStop="False" />
            </Grid>

            <Border Grid.Row="1"
                    Padding="12"
                    Margin="0,0,0,12"
                    Background="{StaticResource CardBrush}"
                    BorderBrush="#33FFFFFF"
                    BorderThickness="1"
                    CornerRadius="14">
                <StackPanel Orientation="Horizontal">
                    <Ellipse Width="10" Height="10" Fill="#FF34D399" Margin="0,0,10,0" VerticalAlignment="Center" />
                    <TextBlock x:Name="StatusText"
                               Foreground="{StaticResource TextBrush}"
                               FontSize="13"
                               VerticalAlignment="Center"
                               Text="대기 중" />
                </StackPanel>
            </Border>

            <Grid Grid.Row="2" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.2*" />
                    <ColumnDefinition Width="0.9*" />
                    <ColumnDefinition Width="0.9*" />
                </Grid.ColumnDefinitions>

                <Border Grid.Column="0"
                        Margin="0,0,10,0"
                        Padding="14"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="빠른 메모"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBox x:Name="MemoInput"
                                 Margin="0,10,0,8"
                                 MinHeight="70"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 VerticalScrollBarVisibility="Auto"
                                 Background="{StaticResource InputBrush}"
                                 Foreground="{StaticResource TextBrush}"
                                 BorderBrush="#44FFFFFF"
                                 BorderThickness="1"
                                 Padding="10"
                                 FontSize="13" />
                        <StackPanel Orientation="Horizontal">
                            <Button Content="메모 저장"
                                    Padding="14,8"
                                    Background="#2A8AD7FF"
                                    Foreground="{StaticResource TextBrush}"
                                    BorderBrush="#55FFFFFF"
                                    Click="SaveMemo_Click"
                                    IsTabStop="False" />
                            <TextBlock Text="떠오를 때 바로 기록"
                                       Margin="10,0,0,0"
                                       VerticalAlignment="Center"
                                       Foreground="{StaticResource MutedBrush}"
                                       FontSize="11" />
                        </StackPanel>
                        <ListBox x:Name="MemoList"
                                 Margin="0,12,0,0"
                                 Height="120"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                 ScrollViewer.VerticalScrollBarVisibility="Auto"
                                 ItemsSource="{Binding Memos}">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Margin" Value="0,0,0,6" />
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderThickness" Value="0" />
                                    <Setter Property="Focusable" Value="False" />
                                </Style>
                            </ListBox.ItemContainerStyle>
                            <ListBox.ItemTemplate>
                                <DataTemplate>
                                    <Border CornerRadius="12"
                                            Padding="10"
                                            Background="#1AFFFFFF"
                                            BorderBrush="#22FFFFFF"
                                            BorderThickness="1">
                                        <StackPanel>
                                            <TextBlock Text="{Binding Text}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="12"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding TimestampText}"
                                                       Margin="0,4,0,0"
                                                       Foreground="{StaticResource MutedBrush}"
                                                       FontSize="10" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ListBox.ItemTemplate>
                        </ListBox>
                    </StackPanel>
                </Border>

                <Border Grid.Column="1"
                        Margin="0,0,10,0"
                        Padding="14"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="집중 타이머"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <TextBlock Text="{Binding FocusElapsedText}"
                                   Margin="0,10,0,2"
                                   FontSize="28"
                                   FontWeight="SemiBold"
                                   Foreground="{StaticResource TextBrush}" />
                        <TextBlock Text="작업 전환을 방해하지 않는 짧은 집중 세션"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                        <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Content="시작/일시정지"
                                    Padding="12,8"
                                    Background="{StaticResource AccentSoftBrush}"
                                    Foreground="{StaticResource TextBrush}"
                                    BorderBrush="#55FFFFFF"
                                    Click="ToggleFocusTimer_Click"
                                    IsTabStop="False" />
                            <Button Content="리셋"
                                    Margin="8,0,0,0"
                                    Padding="12,8"
                                    Background="#18FFFFFF"
                                    Foreground="{StaticResource TextBrush}"
                                    BorderBrush="#44FFFFFF"
                                    Click="ResetFocusTimer_Click"
                                    IsTabStop="False" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Grid.Column="2"
                        Padding="14"
                        Background="{StaticResource CardBrush}"
                        BorderBrush="{StaticResource CardBorderBrush}"
                        BorderThickness="1"
                        CornerRadius="18">
                    <StackPanel>
                        <TextBlock Text="오버레이 포인트"
                                   Foreground="{StaticResource AccentBrush}"
                                   FontSize="12"
                                   FontWeight="SemiBold" />
                        <StackPanel Margin="0,10,0,0">
                            <TextBlock Text="• 최근 클립을 즉시 재사용"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="• 메모를 떠오르는 즉시 기록"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12"
                                       Margin="0,0,0,6" />
                            <TextBlock Text="• 타이머로 흐름만 유지"
                                       Foreground="{StaticResource TextBrush}"
                                       FontSize="12" />
                        </StackPanel>
                        <TextBlock Text="Ctrl 홀드 시 창이 더 진하게 보입니다."
                                   Margin="0,12,0,0"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="11"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Border Grid.Row="3"
                    Padding="0"
                    Background="Transparent"
                    BorderThickness="0">
                <StackPanel>
                    <TextBlock Text="최근 클립"
                               Margin="2,0,0,8"
                               Foreground="{StaticResource AccentBrush}"
                               FontSize="12"
                               FontWeight="SemiBold" />
                    <ListBox x:Name="HistoryList"
                             Background="Transparent"
                             BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                             ScrollViewer.VerticalScrollBarVisibility="Auto"
                             SelectionMode="Single"
                             MouseLeftButtonUp="HistoryList_MouseLeftButtonUp"
                             KeyDown="HistoryList_KeyDown">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Margin" Value="0,0,0,10" />
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Background" Value="Transparent" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Focusable" Value="True" />
                                <Style.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter Property="BorderThickness" Value="0" />
                                    </Trigger>
                                </Style.Triggers>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Border CornerRadius="18"
                                        Background="{StaticResource CardBrush}"
                                        BorderBrush="{StaticResource CardBorderBrush}"
                                        BorderThickness="1"
                                        Padding="14">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <Border Width="84"
                                                Height="84"
                                                CornerRadius="14"
                                                Background="#1AFFFFFF"
                                                BorderBrush="#22FFFFFF"
                                                BorderThickness="1"
                                                VerticalAlignment="Top">
                                            <Grid>
                                                <Image Source="{Binding Image}"
                                                       Stretch="UniformToFill"
                                                       Visibility="{Binding IsImage, Converter={StaticResource BoolToVis}}" />
                                                <TextBlock Text="TXT"
                                                           HorizontalAlignment="Center"
                                                           VerticalAlignment="Center"
                                                           FontSize="18"
                                                           FontWeight="Bold"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           Visibility="{Binding IsText, Converter={StaticResource BoolToVis}}" />
                                            </Grid>
                                        </Border>

                                        <StackPanel Grid.Column="1" Margin="14,0,0,0">
                                            <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                <TextBlock Text="{Binding KindLabel}"
                                                           Foreground="{StaticResource AccentBrush}"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                                <TextBlock Text="  ·  Ctrl+클릭으로 고정"
                                                           Foreground="#FF9CA3AF"
                                                           FontSize="12" />
                                            </StackPanel>
                                            <TextBlock Text="{Binding Preview}"
                                                       Foreground="{StaticResource TextBrush}"
                                                       FontSize="14"
                                                       TextWrapping="Wrap"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding TimestampText}"
                                                       Margin="0,8,0,0"
                                                       Foreground="#FF9CA3AF"
                                                       FontSize="11" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </StackPanel>
            </Border>

            <TextBlock Grid.Row="4"
                       Margin="2,12,2,0"
                       Foreground="#FF9CA3AF"
                       FontSize="11"
                       Text="팁: 일반 클릭은 미리보기 선택, Ctrl+클릭은 선택한 항목을 클립보드로 다시 복사합니다. 메모/타이머는 작업 중단 없이 곁에 붙는 보조 도구입니다." />
        </Grid>
    </Border>
</Window>
