<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ApplicationIcon>Assets/GlassboardIcon.ico</ApplicationIcon>
    <AssemblyName>Glassboard</AssemblyName>
    <RootNamespace>Glassboard</RootNamespace>
    <Version>0.2.45</Version>
    <AssemblyVersion>0.2.45.0</AssemblyVersion>
    <FileVersion>0.2.45.0</FileVersion>
    <InformationalVersion>0.2.45</InformationalVersion>
  </PropertyGroup>

  <ItemGroup>
    <Resource Include="Assets/GlassboardIcon.ico" />
    <Resource Include="Assets/GlassboardIcon.png" />
  </ItemGroup>
</Project>
