<Application x:Class="Glassboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <SolidColorBrush x:Key="PanelBrush" Color="#CC111827" />
            <SolidColorBrush x:Key="CardBrush" Color="#CC1F2937" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#66FFFFFF" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF7DD3FC" />
            <SolidColorBrush x:Key="TextBrush" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FFD1D5DB" />
        </ResourceDictionary>
    </Application.Resources>
</Application>
