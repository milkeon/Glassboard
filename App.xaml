<Application x:Class="Glassboard.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Application.Resources>
        <ResourceDictionary>
            <BooleanToVisibilityConverter x:Key="BoolToVis" />
            <SolidColorBrush x:Key="PanelBrush" Color="#D2121A24" />
            <SolidColorBrush x:Key="CardBrush" Color="#CC1B2533" />
            <SolidColorBrush x:Key="CardBorderBrush" Color="#1F33404E" />
            <SolidColorBrush x:Key="AccentBrush" Color="#FF8AD7FF" />
            <SolidColorBrush x:Key="AccentSoftBrush" Color="#337DD3FC" />
            <SolidColorBrush x:Key="TextBrush" Color="#FFF8FAFC" />
            <SolidColorBrush x:Key="MutedBrush" Color="#FFC7CED9" />
            <SolidColorBrush x:Key="InputBrush" Color="#1F000000" />
        </ResourceDictionary>
    </Application.Resources>
</Application>